# Dockerfile.node-base
FROM node:20.19.4-alpine3.22@sha256:df02558528d3d3d0d621f112e232611aecfee7cbc654f6b375765f72bb262799

# Non-root user 생성 (Defense-in-depth)
RUN adduser -D -s /bin/sh appuser

# 작업 디렉토리
WORKDIR /code

# Output 및 Workspace 디렉토리 생성 및 권한 설정
RUN mkdir -p /output /workspace && chown appuser:appuser /output /workspace
RUN chown -R appuser:appuser /code

# Non-root user로 전환
USER appuser
