# Dockerfile.cpp-base
FROM gcc:14.3.0-bookworm@sha256:5e927c284bf55a7dc796262e311a0703344f62f41f5621eb56843111b1d37e15

# Non-root user 생성 (Defense-in-depth)
RUN useradd -m -s /bin/bash appuser

# 작업 디렉토리
WORKDIR /code

# Output 및 Workspace 디렉토리 생성 및 권한 설정
RUN mkdir -p /output /workspace && chown appuser:appuser /output /workspace
RUN chown -R appuser:appuser /code

# Non-root user로 전환
USER appuser
